{
    "name": "cosmira/strangler",
    "description": "A Strangler Fig adapter for incrementally replacing legacy Yii applications with modern HTTP backends.",
    "keywords": [
        "strangler",
        "strangler-fig",
        "legacy",
        "incremental-migration",
        "yii",
        "proxy"
    ],
    "homepage": "https://github.com/cosmira/strangler",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandr Chernyaev",
            "email": "bliz48rus@gmail.com",
            "homepage": "https://tabuna.github.io",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/cosmira/strangler/issues",
        "source": "https://github.com/cosmira/strangler"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.7",
        "yiisoft/yii": "^1.1.31",
        "ext-json": "*"
    },
    "require-dev": {
        "infection/infection": "^0.32.4",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6.7"
    },
    "autoload": {
        "psr-4": {
            "Cosmira\\Strangler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cosmira\\Strangler\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:coverage": "@php -d pcov.enabled=1 -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text",
        "test:mutation": "@php vendor/bin/infection",
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:rector": [
            "@php vendor/bin/rector validate-config",
            "@php vendor/bin/rector process --dry-run --no-progress-bar"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
